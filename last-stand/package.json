{
  "name": "last-stand",
  "private": true,
  "version": "0.6.0",
  "description": "Last Stand: a browser roguelite tower defense game.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "balance": "vitest run --config vitest.balance.config.ts",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "art": "vitest run --config vitest.art.config.ts",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@fontsource/jersey-10": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
